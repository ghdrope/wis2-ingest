{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "development"
  ],
  "useBaseBranchConfig": "merge",
  "reviewers": ["ghdrope"],
  "labels": ["renovate"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep Helm appVersion in sync",
      "managerFilePatterns": [
        "/(^|/)Chart\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate: datasource=github-releases depName=ghdrope/wis2-ingest[^\\n]*\\nappVersion:\\s*[\"']?(?<currentValue>[^\"'\\s]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "ghdrope/wis2-ingest",
      "extractVersionTemplate": "^v?(?<version>\\d+\\.\\d+)",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "reviewers": ["ghdrope"],
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "matchFileNames": [
        ".github/workflows/**"
      ],
      "groupName": "GitHub Workflows",
      "commitMessageTopic": "GitHub Workflows"
    },
    {
      "matchFileNames": [
        "go.**"
      ],
      "groupName": "Go Packages",
      "commitMessageTopic": "Go Packages"
    }
  ]
}
