{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "WIS2 Ingestor",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd",
      "args": ["ingestor"],

      "preLaunchTask": "debug-up",
      
      "env": {
        "DEBUG": "true",
        "LOG_LEVEL": "debug",
        "LOG_FORMAT": "console",

        "WIS2_MQTT_TOPIC": "origin/a/wis2/#",
        "WIS2_OUTPUT_DIRECTORY": "./tmp/debug_data",

        "WIS2_AUTH_POLICIES_CONFIGMAP_PATH": "${workspaceFolder}/hack/debug/auth-policies.yaml",
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },

    {
      "name": "WIS2 Doctor",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd",
      "args": ["doctor"],
      "env": {
        "DEBUG": "true",
        "LOG_LEVEL": "debug",
        "LOG_FORMAT": "console",

        "WIS2_MQTT_TOPIC": "origin/a/wis2/#",
        "WIS2_OUTPUT_DIRECTORY": "./tmp/debug_data",
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },

    {
      "name": "WIS2 Validate",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd",
      "args": ["validate"],
      "env": {
        "DEBUG": "true",
        "LOG_LEVEL": "debug",
        "LOG_FORMAT": "console",

        "WIS2_MQTT_TOPIC": "origin/a/wis2/#",
        "WIS2_OUTPUT_DIRECTORY": "./tmp/debug_data",
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
    },

    {
      "name": "WIS2 Version",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd",
      "args": ["version"],
      "env": {
        "DEBUG": "true",
        "LOG_LEVEL": "debug",
        "LOG_FORMAT": "console",

        "WIS2_MQTT_TOPIC": "origin/a/wis2/#",
        "WIS2_OUTPUT_DIRECTORY": "./tmp/debug_data",
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
    }
  ]
}